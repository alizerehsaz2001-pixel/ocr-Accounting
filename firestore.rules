rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (Pillar 1)
    match /{document=**} {
      allow read, write: if false;
    }

    // Check if the user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the user is accessing their own document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Check if ID format is valid (supports letters, numbers, underscores, hyphens, and dots)
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // Helper for incoming document data
    function incoming() {
      return request.resource.data;
    }

    // Helper for user validation schema
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role', 'status'])
        && data.id is string
        && data.name is string
        && data.name.size() <= 200
        && data.email is string
        && data.email.size() <= 200
        && data.role in ['admin', 'user']
        && data.status in ['active', 'suspended'];
    }

    // Helper for folder validation schema
    function isValidFolder(data) {
      return data.keys().hasAll(['name', 'color', 'createdAt'])
        && data.name is string
        && data.name.size() <= 200
        && data.color is string
        && data.color.size() <= 50
        && data.createdAt is string
        && (!data.keys().contains('description') || data.description == null || (data.description is string && data.description.size() <= 1000));
    }

    // Helper for scan validation schema
    function isValidScan(data) {
      return data.keys().hasAll(['id', 'timestamp', 'file', 'transactions'])
        && data.id is string
        && (data.timestamp is int || data.timestamp is number)
        && data.file is map
        && data.transactions is list;
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
      
      allow list: if isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      // Creating own user document is allowed upon first sign-in
      allow create: if isSignedIn() 
        && isOwner(userId) 
        && isValidUser(incoming())
        && (incoming().role == 'user' || incoming().email == 'alizerehsaz2001@gmail.com');

      // Modifying profiles
      allow update: if isSignedIn() 
        && (
          (isOwner(userId) && incoming().role == resource.data.role && incoming().status == resource.data.status && isValidUser(incoming())) 
          || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' && isValidUser(incoming()))
        );

      allow delete: if isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      // Subcollections of users for custom folders
      match /folders/{folderId} {
        allow read, get, list: if isSignedIn() && isOwner(userId);
        allow create, update: if isSignedIn() && isOwner(userId) && isValidId(folderId) && isValidFolder(incoming());
        allow delete: if isSignedIn() && isOwner(userId) && isValidId(folderId);
      }

      // Subcollections of users for scanned documents
      match /scans/{scanId} {
        allow read, get, list: if isSignedIn() && isOwner(userId);
        allow create, update: if isSignedIn() && isOwner(userId) && isValidId(scanId) && isValidScan(incoming());
        allow delete: if isSignedIn() && isOwner(userId) && isValidId(scanId);
      }
    }

    // Simple test connection rules
    match /test/connection {
      allow read: if isSignedIn();
    }
  }
}
